<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="regulus-ai"
    version="0.12.0.0"
    processorArchitecture="*"/>
  <description>Regulus AI core CLI</description>
