{
  "execution": {
    "max_timeout_sec": 3600,
    "allowlist": ["go", "gremlins", "govulncheck", "bunx", "bun"]
  },
  "gates": [
    { "name": "manifest-check", "layer": 1, "command": "go run ./cmd/regulus manifest check", "category": "proof", "required": true },
    { "name": "typecheck", "layer": 2, "command": "go build ./...", "category": "build", "required": true },
    { "name": "lint", "layer": 3, "command": "go vet -appends -asmdecl -assign -atomic -bools -buildtag -cgocall -composites -copylocks -defers -directive -errorsas -framepointer -hostport -httpresponse -ifaceassert -loopclosure -lostcancel -nilfunc -printf -shift -sigchanyzer -slog -stdmethods -stdversion -stringintconv -structtag -testinggoroutine -tests -timeformat -unmarshal -unreachable -unsafeptr -unusedresult -waitgroup ./...", "category": "analysis", "required": true },
    { "name": "build", "layer": 4, "command": "go build -o bin/regulus ./cmd/regulus", "category": "build", "required": true },
    { "name": "unit-tests", "layer": 5, "command": "go test ./... -coverprofile .regulus/coverage.out", "category": "test", "required": true },
    { "name": "coverage-floor", "layer": 6, "command": "go tool cover -func .regulus/coverage.out", "metric": { "extract": "last-line-percent", "threshold": 80, "operator": ">=" }, "category": "test", "required": true },
    { "name": "mutation-receipts", "layer": 7, "command": "gremlins unleash ./internal/receipts --threshold-efficacy 70 --workers 4 --timeout-coefficient 10", "timeout_sec": 300, "category": "test", "required": false, "profiles": ["full"] },
    { "name": "mutation-gates", "layer": 8, "command": "gremlins unleash ./internal/gates --threshold-efficacy 70 --workers 4 --timeout-coefficient 10", "timeout_sec": 600, "category": "test", "required": false, "profiles": ["full"] },
    { "name": "crap", "layer": 9, "command": "go run ./cmd/regulus crap --profile .regulus/coverage.out --max 30 --max-critical 30 --max-standard 50 --top 5", "category": "analysis", "required": true },
    { "name": "vulncheck", "layer": 10, "command": "govulncheck ./...", "timeout_sec": 120, "category": "security", "required": false, "profiles": ["full", "security"] },
    { "name": "spec", "layer": 11, "command": "go run ./cmd/regulus spec check charts/", "reproducibility": "exact", "category": "proof", "required": true },
    { "name": "ts-typecheck", "layer": 12, "command": "bunx tsc --noEmit -p .opencode/tsconfig.json", "category": "build", "required": true },
    { "name": "ts-unit-tests", "layer": 13, "command": "bun test ./.opencode/lib/", "category": "test", "required": true },
    { "name": "gofmt", "layer": 14, "command": "go test ./internal/gates/ -run TestGofmtClean -count=1", "category": "analysis", "required": true },
    { "name": "race-almanac", "layer": 15, "command": "go test -race -count=1 ./internal/almanac/", "category": "test", "required": false, "profiles": ["full"] }
  ]
}
