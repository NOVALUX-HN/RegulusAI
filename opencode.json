{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "rd *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git push *force*": "deny",
      "git branch -D*": "deny",
      "git stash drop*": "deny",
      "git rm*": "deny",
      "git checkout --*": "deny",
      "git restore*": "deny",
      "git rebase*": "deny",
      "format *": "deny",
      "mkfs*": "deny",
      "dd *": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "doom_loop": "ask"
  }
}
