# Regulus runtime state — per-project, never committed
.regulus/

# OpenCode plugin development
node_modules/

# Build output (binaries stay ignored; the launcher source is tracked)
bin/*
!bin/regulus.js
dist/

# Tool cache directories
.atl/
binaries/

# Local tool output (regenerable diagrams, reviews)
.archify/

# Generated Almanac export bundle (share as artifact, not committed)
.regulus-export/

# ODD feature docs are tracked (specs, tasks, log per phase);
# scratch notes under odd/ outside tasks/ stay local.
odd/*
!odd/tasks/

# Generated evidence view (retired from tracking; regenerate locally via
# `regulus evidence list --task <t>` when needed)
docs/EVIDENCE.md

# OS noise (open source contributors)
.DS_Store
Thumbs.db
